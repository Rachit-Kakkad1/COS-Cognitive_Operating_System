{
  "manifest_version": 3,
  "name": "COS WorkSense — Cognitive Workforce Intelligence",
  "version": "1.0.0",
  "description": "Manager dashboard · Focus reports · Productivity matrix · Power + CPU monitoring",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "alarms",
    "notifications",
    "system.cpu",
    "system.memory",
    "system.storage",
    "processes"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/worksense-16.png",
      "48": "icons/worksense-48.png",
      "128": "icons/worksense-128.png"
    }
  }
}
