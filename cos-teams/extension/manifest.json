{
  "manifest_version": 3,
  "name": "COS Teams — Shared Cognitive Capture",
  "version": "1.0.0",
  "description": "Shared cognitive memory for co-founders and small teams",
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "host_permissions": [
    "http://localhost:8002/*",
    "<all_urls>"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://localhost:5175/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "COS Teams"
  }
}
